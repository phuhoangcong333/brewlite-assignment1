    {
      "name": "Request 07 — Thử lại thanh toán bằng ví",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const orderId = Number(pm.collectionVariables.get(\"orderId\"));\r",
              "const key = String(pm.collectionVariables.get(\"paymentKey\") || \"\").trim();\r",
              "if (!Number.isInteger(orderId) || orderId <= 0 || !key) {\r",
              "    throw new Error(\"Chạy Request 02, 03 và 05 trước khi thanh toán.\");\r",
              "}\r",
              "pm.request.headers.remove(\"Content-Length\");\r",
              "pm.request.headers.upsert({ key: \"Content-Type\", value: \"application/json\" });\r",
              "pm.request.headers.upsert({ key: \"Idempotency-Key\", value: key + \"-success\" });\r",
              "pm.request.body.update(JSON.stringify({\r",
              "    orderId, method: \"WALLET\", walletId: \"TV2-WALLET-1234\"\r",
              "}));"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Thanh toán trả HTTP 201\", () => {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Thanh toán thành công và lưu paymentId\", () => {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data.payment_status).to.eql(\"PAID\");\r",
              "    pm.expect(data.order_status).to.eql(\"PAID\");\r",
              "    pm.expect(data.replayed).to.be.a(\"boolean\");\r",
              "    pm.expect(data.orderId).to.eql(Number(pm.collectionVariables.get(\"orderId\")));\r",
              "    pm.expect(data.amount).to.eql(Number(pm.collectionVariables.get(\"orderTotal\")));\r",
              "    pm.expect(data.paymentId).to.be.a(\"number\").above(0);\r",
              "    pm.collectionVariables.set(\"paymentId\", data.paymentId);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
