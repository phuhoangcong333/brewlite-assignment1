      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Đăng nhập thành công: 200\", () => pm.response.to.have.status(200));\r",
              "\r",
              "pm.test(\"Nhận JWT\", () => {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data.access_token).to.be.a(\"string\").that.is.not.empty;\r",
              "    pm.expect(data.token_type).to.eql(\"Bearer\");\r",
              "    pm.collectionVariables.set(\"token\", data.access_token);\r",
              "});\r",
              "\r",
              ""
