      "name": "Request 09 — Lịch sử đơn cá nhân",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));\r",
              "\r",
              "pm.test(\"Lịch sử chỉ chứa đơn của tài khoản này\", () => {\r",
              "    const orders = pm.response.json();\r",
              "    const userId = Number(pm.collectionVariables.get(\"userId\"));\r",
              "    const orderId = Number(pm.collectionVariables.get(\"orderId\"));\r",
              "\r",
              "    pm.expect(orders).to.be.an(\"array\").that.is.not.empty;\r",
              "    orders.forEach(order => pm.expect(order.userId).to.eql(userId));\r",
              "    pm.expect(orders.find(order => order.id === orderId).status).to.eql(\"PAID\");\r",
              "\r",
              "    for (let i = 1; i < orders.length; i++) {\r",
              "        pm.expect(Date.parse(orders[i - 1].createdAt))\r",
              "            .to.be.at.least(Date.parse(orders[i].createdAt));\r",
              "    }\r",
              "});"
            ],
