              "pm.test(\"Tạo đơn thành công: 201\", () => pm.response.to.have.status(201));\r",
              "\r",
              "pm.test(\"Đơn PENDING và tính đúng giá\", () => {\r",
              "    const order = pm.response.json();\r",
              "    const expected = Number(pm.collectionVariables.get(\"productPrice\")) + 5000 + 5000;\r",
              "\r",
              "    pm.expect(order.status).to.eql(\"PENDING\");\r",
              "    pm.expect(order.total).to.eql(expected);\r",
              "    pm.collectionVariables.set(\"orderId\", order.id);\r",
              "    pm.collectionVariables.set(\"orderTotal\", order.total);\r",
              "});"
