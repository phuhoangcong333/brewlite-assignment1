  "item": [
    {
      "name": "Request 01 — Danh sách sản phẩm",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));\r",
              "\r",
              "pm.test(\"Menu có đủ thông tin sản phẩm\", () => {\r",
              "    const products = pm.response.json();\r",
              "    pm.expect(products).to.be.an(\"array\").that.is.not.empty;\r",
              "\r",
              "    products.forEach(p => {\r",
              "        pm.expect(p).to.include.all.keys(\"id\", \"name\", \"price\", \"imageUrl\");\r",
              "        pm.expect(p.price).to.be.above(0);\r",
              "    });\r",
              "\r",
              "    const product = products.find(p => p.stock >= 2);\r",
              "    pm.expect(product, \"Cần một sản phẩm còn ít nhất 2 phần\").to.exist;\r",
              "    pm.collectionVariables.set(\"productId\", product.id);\r",
              "    pm.collectionVariables.set(\"productPrice\", product.price);\r",
              "});\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Request 02 — Đăng ký",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const runId = Date.now() + \"-\" + Math.random().toString(36).slice(2, 8);\r",
              "pm.collectionVariables.set(\"email\", `tv2-${runId}@example.com`);\r",
              "pm.collectionVariables.set(\"paymentKey\", `tv2-payment-${runId}`);\r",
              "pm.collectionVariables.unset(\"token\");"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Đăng ký thành công: 201\", () => pm.response.to.have.status(201));\r",
              "\r",
              "pm.test(\"Tài khoản đúng, không lộ mật khẩu\", () => {\r",
              "    const user = pm.response.json().user;\r",
              "    pm.expect(user.email).to.eql(pm.collectionVariables.get(\"email\"));\r",
              "    pm.expect(user.role).to.eql(\"CUSTOMER\");\r",
              "    pm.expect(user).not.to.have.property(\"passwordHash\");\r",
              "    pm.expect(user).not.to.have.property(\"password\");\r",
              "    pm.collectionVariables.set(\"userId\", user.id);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"{{password}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
